# =====================================================================
#  Grab MY Hari Sukan 2026 - environment settings (grab-day.vercel.app)
#  Live values are in Vercel: project "grab" -> Settings -> Environment Variables
#  Fill each value below by copying it from there. Keep this file private.
#  After changing any value in Vercel: Deployments -> Redeploy -> Promote to Production.
# =====================================================================

# --- Database (Supabase) --------------------------------------------
# Supabase -> Project Settings -> API
# Use the "anon public" key. NEVER the service_role key.
REACT_APP_SUPABASE_URL=https://__________.supabase.co
REACT_APP_SUPABASE_ANON_KEY=__________

# --- Logins ----------------------------------------------------------
# Admin page: grab-day.vercel.app/#/admin   (default if not set: grab2026)
REACT_APP_ADMIN_PASSWORD=__________
# Staff stations (lobby check-in, lunch counter): #/staff   (default if not set: 1234)
REACT_APP_STAFF_PIN=__________

# --- Emails (Resend) - server side only --------------------------------
# Resend -> API Keys (the account that owns smartsl-events.com)
RESEND_KEY=re___________
FROM_EMAIL=Grab MY Hari Sukan <events@smartsl-events.com>
# Optional: where replies go
REPLY_TO=

# --- Public site address used in email links --------------------------
SITE_URL=https://grab-day.vercel.app
REACT_APP_SITE_URL=https://grab-day.vercel.app
